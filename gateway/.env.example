# Gateway-Konfiguration — kopieren nach ".env" (wird NICHT committet).

# --- ChurchTools ---
CT_BASE_URL=https://EUREGEMEINDE.church.tools
# Login-Token eines technischen Benutzers (ChurchTools > Persoenliche Einstellungen)
CT_LOGIN_TOKEN=hier_den_login_token_eintragen

# --- VOCO-Geraet (nur Fallback) ---
# Bevorzugt wird das Geraet in der ChurchTools-Extension konfiguriert.
# Diese Werte greifen nur, falls dort kein Geraet hinterlegt ist:
#VOCO_SERIAL=VH-XXXXXX
#VOCO_DEVICE_PW=geheim
#VOCO_BROKER_URL=wss://hew-voco.de:8084/mqtt

# --- Automatische Fehler-E-Mails (optional, empfohlen fuer Tests) ---
# Bei Fehlern wird eine Mail an EMAIL_TO gesendet (mit Spam-Sperre je Betreff).
# Ohne SMTP_HOST bleibt es still (nur Log). SMTP = beliebiger Postausgang.
#SMTP_HOST=smtp.example.de
#SMTP_PORT=587
#SMTP_USER=postausgang@example.de
#SMTP_PASS=geheim
#SMTP_TLS=1                       # STARTTLS (Port 587). Fuer Port 465 stattdessen SMTP_SSL=1
#EMAIL_FROM=postausgang@example.de
#EMAIL_TO=josua.hess@icloud.com   # Standard-Empfaenger
#EMAIL_MIN_INTERVAL=3600          # Sekunden Spam-Sperre je Fehlerart

# --- Optional ---
# Simulationsmodus: plant + protokolliert, loest aber NICHT aus (wie --dry-run,
# aber dauerhaft). Zum sicheren Einrichten empfohlen; zum Scharfschalten entfernen.
#VOCO_SIMULATION=1
# Ruhezeit, in der NIE ausgeloest wird (z. B. nachts):
#VOCO_QUIET=22:00-06:00
# Modul-Shorty der Extension (Standard: glockensteuerung)
#VOCO_EXT_KEY=glockensteuerung
