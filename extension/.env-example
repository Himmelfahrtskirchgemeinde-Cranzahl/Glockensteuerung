# Extension-Key (Modul-Shorty in ChurchTools)
VITE_KEY=glockensteuerung

# Zentraler Feedback-/Fehler-Endpunkt (optional).
# Wenn gesetzt, gehen Feedback UND automatische Fehlermeldungen als POST (JSON)
# dorthin -> zentrales Postfach (empfohlen bei mehreren Testern).
# Beispiele: Formspree/Web3Forms-Endpunkt oder eigener Webhook.
# Leer lassen -> Feedback per mailto an josua.hess@icloud.com, keine Auto-Fehlermails.
VITE_FEEDBACK_URL=

# Nur fuer lokale Entwicklung (npm run dev):
VITE_BASE_URL=https://EUREGEMEINDE.church.tools
VITE_USERNAME=dein-ct-benutzer
VITE_PASSWORD=dein-ct-passwort
