# Vorlage — echte Werte in eine lokale Datei ".env" kopieren (NICHT committen!).
# .env ist per .gitignore ausgeschlossen.

# --- VOCO ST5 (MQTT über app.hew-voco.de) ---
# Seriennummer des Geräts (Typenschild / Portal), z. B. VH-xxxxxx
VOCO_SERIAL=VH-XXXXXX
# Geräte-Passwort (aus dem Portal-JS / von HEW). GEHEIM!
VOCO_DEVICE_PW=xxxxxxxxxx
# Broker (Standard, i. d. R. nicht ändern)
VOCO_BROKER_HOST=hew-voco.de
VOCO_BROKER_PORT=8084
VOCO_BROKER_USER=hewWeb
VOCO_BROKER_PASS=vocoWeb
VOCO_WS_PATH=/mqtt

# --- ChurchTools (später) ---
CT_BASE_URL=https://DEINE-GEMEINDE.church.tools
CT_LOGIN_TOKEN=xxxxxxxx
