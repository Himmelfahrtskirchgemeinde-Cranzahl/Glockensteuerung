# Vorlage fuer lokale Konfiguration. Kopieren nach ".env" und ausfuellen.
# ".env" ist via .gitignore ausgeschlossen und darf NIE committet werden!

# --- HEW VOCO Cloud-API (app.hew-voco.de) ---
VOCO_API_BASE=https://app.hew-voco.de/api
VOCO_API_KEY=hier_den_geheimen_api_key_eintragen
# Auth-Header-Variante (je nach API-Doku): "bearer" oder "x-api-key"
VOCO_AUTH_STYLE=bearer

# --- ChurchTools ---
CT_BASE_URL=https://EUREGEMEINDE.church.tools
CT_API_TOKEN=hier_den_churchtools_login_token_eintragen
